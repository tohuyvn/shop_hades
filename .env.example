# Shop Hades — copy thành .env và điền giá trị thật
APP_NAME=Shop Hades
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8000
APP_HOTLINE=1800 1234

# Database (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop_hades
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SOCKET=
DB_CONNECT_TIMEOUT=3
DB_CONNECT_RETRIES=2
DB_RETRY_DELAY_MS=150

# Docker Compose dùng tài khoản riêng; hãy đổi password khi public lâu dài
DOCKER_DB_DATABASE=shop_hades
DOCKER_DB_USERNAME=hades_user
DOCKER_DB_PASSWORD=hades_password

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME=Shop Hades
MAIL_SSL_VERIFY=false

# OTP (chỉ dùng khi đăng ký / quên mật khẩu)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60

# Password reset (quên mật khẩu / admin đặt lại)
PASSWORD_RESET_OTP_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_MAX_SEND_PER_HOUR=5
PASSWORD_RESET_MAX_VERIFY_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60

# Gemini chatbot — Trợ lý AI (nhanh, có lịch sử hội thoại)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Analytics (để trống nếu chưa dùng)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Ollama (tùy chọn — fallback local khi Gemini lỗi)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
OLLAMA_MAX_TOKENS=500
OLLAMA_TEMPERATURE=0.6

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/payment/vnpay/return
VNPAY_DEFAULT_BANK=NCB
VNPAY_EXPIRE_MINUTES=30

# MoMo sandbox
MOMO_PARTNER_CODE=
MOMO_PARTNER_NAME=Shop Hades
MOMO_STORE_ID=ShopHades
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://127.0.0.1:8000/payment/momo/return
MOMO_IPN_URL=http://127.0.0.1:8000/payment/momo/callback
MOMO_MAX_AMOUNT=20000000

# Chuyển khoản VietQR (MB Bank)
BANK_TRANSFER_BANK_CODE=MB
BANK_TRANSFER_BANK_NAME=MB Bank
BANK_TRANSFER_ACCOUNT_NO=0788415516
BANK_TRANSFER_ACCOUNT_NAME=TO QUANG HUY
BANK_TRANSFER_ACCOUNT_NAME_DISPLAY=Tô Quang Huy
BANK_TRANSFER_TEMPLATE=compact2
# Tự xác nhận + redirect khi nhận webhook SePay (Money in)
BANK_TRANSFER_AUTO_CONFIRM=true
# SePay → Webhooks → URL: {APP_BASE_URL}/payment/vietqr/webhook
# Auth: Authorization: Apikey <key>
SEPAY_WEBHOOK_API_KEY=

# JWT (REST API)
JWT_SECRET=
JWT_EXPIRE_SECONDS=86400
